# ==============================================================================
# Torniquete Link - Variables de Entorno y Configuración del Servidor
# ==============================================================================

# Puerto HTTP en el que escuchará el servidor (por defecto 3000)
PORT=3000

# Secreto criptográfico para firma y protección de sesiones administrativas
# Generar una cadena larga y aleatoria en producción (ej. openssl rand -hex 32)
SESSION_SECRET=cambiar_este_secreto_por_uno_seguro_en_produccion

# Tiempo máximo de espera para la API externa escolar en milisegundos (recomendado <= 1200ms)
# Crucial: El hardware Hikvision entra en timeout a los 1500ms
EXTERNAL_API_TIMEOUT_MS=1100

# Días de retención para el historial de accesos antes de depuración automática diaria
LOG_RETENTION_DAYS=30

# Entorno de ejecución ('development' o 'production')
NODE_ENV=development

# Credenciales e integración API v2 AcuaticApp (Multihivesoft)
ACUATICAPP_BASE_URL=https://multihivesoft.com
ACUATICAPP_USER=usuario_escuela
ACUATICAPP_PASSWORD=password_escuela

# Horas del día (0-23 en formato de 24h separadas por coma) para la sincronización automática recurrente
# Por defecto: 15,23 (se ejecuta a las 15:00 hrs y a las 23:00 hrs todos los días)
ACUATICAPP_SYNC_HOURS=15,23
